DATABASE_URL=jdbc:postgresql://localhost:5432/pharma_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=replace-me
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
INTERNAL_SERVICE_TOKEN=replace-with-a-random-internal-service-token
EUREKA_URL=http://localhost:8761/eureka
EUREKA_HOST=localhost
MEDICINE_SERVICE_URL=http://localhost:8082
FRONTEND_ORIGIN=http://localhost:3000
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
FRONTEND_API_BASE_URL=http://localhost:8080
JPA_DDL_AUTO=update
# Render sets PORT automatically. Leave unset locally so each service uses its default port.
# On Render, do not paste a postgres:// URL into DATABASE_URL. Use jdbc:postgresql://HOST:5432/DBNAME?sslmode=require
# Optional Eureka advertisement on Render (unset for local Docker Compose):
# EUREKA_INSTANCE_HOSTNAME=your-service.onrender.com
# EUREKA_INSTANCE_PREFER_IP_ADDRESS=false
# EUREKA_INSTANCE_NON_SECURE_PORT=443
